# ===== Cesium GIS Editor 环境配置示例 =====
# 复制为 .env 后填写真实值。所有 Key/Token 纯属可选——不填也能用（走公开底图 + 会话 Key）。

PORT=3001
NODE_ENV=development

# ===== CORS 白名单（逗号分隔；生产环境填你的域名）=====
ALLOWED_ORIGINS=http://localhost:8080

# ===== Cesium Ion Token（可选；不填则用 OSM/Esri 等公开底图）=====
# 申请地址：https://ion.cesium.com/tokens
CESIUM_ION_TOKEN=

# ===== 天地图 Token（可选；不填则不加载天地图底图）=====
# 申请地址：https://console.tianditu.gov.cn/
TIANDITU_TOKEN=

# ===== AI 每日配额（可选，默认 500）=====
AI_DAILY_QUOTA=500
