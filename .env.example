# ===== Cesium GIS Editor 环境配置示例 =====
# 复制为 .env 后填写真实值。所有配置纯属可选——不填也能用（走公开底图 + 会话 Key）。
#
# 安全设计：服务端不存储任何地图 Token / AI Key。
#   - Cesium Ion Token / 天地图 Token：用户在页面弹窗里自行输入（仅存于浏览器会话内存，刷新即清）
#   - AI API Key：用户在页面 🔑 按钮里自行输入（纯会话，不落盘）
# 不填 Token 时使用 OSM / Esri / 高德等公开底图，功能完整。

PORT=3001
NODE_ENV=development

# ===== CORS 白名单（逗号分隔；生产环境填你的域名）=====
ALLOWED_ORIGINS=http://localhost:8080

# ===== AI 每日配额（可选，默认 500）=====
AI_DAILY_QUOTA=500
